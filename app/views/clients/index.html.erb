<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">Clientes</h1>
  <%= link_to "Novo cliente", new_client_path, class: "btn btn-primary" %>
</div>

<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>Nome</th>
            <th>Documento</th>
            <th>Telefone</th>
            <th>E-mail</th>
            <th class="text-end">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% if @clients.any? %>
            <% @clients.each do |client| %>
              <tr>
                <td class="align-middle"><%= client.name %></td>
                <td class="align-middle">
                  <span class="badge bg-secondary text-uppercase"><%= client.document_type %></span>
                  <%= client.document_number %>
                </td>
                <td class="align-middle"><%= client.phones.first %></td>
                <td class="align-middle"><%= client.email.presence || "—" %></td>
                <td class="align-middle text-end text-nowrap">
                  <%= link_to "Ver", client_path(client), class: "btn btn-sm btn-outline-secondary" %>
                  <%= link_to "Editar", edit_client_path(client), class: "btn btn-sm btn-outline-primary ms-1" %>
                  <%= button_to "Excluir", client_path(client), method: :delete,
                      class: "btn btn-sm btn-outline-danger ms-1",
                      form: { data: { turbo_confirm: "Tem certeza que deseja excluir #{client.name}?" } } %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="5" class="text-center text-muted py-4">Nenhum cliente encontrado.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
