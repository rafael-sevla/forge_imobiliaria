<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="h3 mb-0"><%= @client.name %></h1>
    <p class="text-muted mb-0">
      <span class="badge bg-secondary text-uppercase"><%= @client.document_type %></span>
      <%= @client.document_number %>
    </p>
  </div>
  <div class="d-flex gap-2">
    <%= link_to "Editar", edit_client_path(@client), class: "btn btn-outline-primary" %>
    <%= link_to "Voltar", clients_path, class: "btn btn-outline-secondary" %>
  </div>
</div>

<div class="row g-4">
  <div class="col-12 col-lg-6">
    <div class="card h-100">
      <div class="card-header">Dados pessoais</div>
      <div class="card-body">
        <dl class="row mb-0">
          <dt class="col-sm-4">Nome</dt>
          <dd class="col-sm-8"><%= @client.name %></dd>

          <dt class="col-sm-4">Documento</dt>
          <dd class="col-sm-8"><%= @client.document_type.upcase %>: <%= @client.document_number %></dd>

          <dt class="col-sm-4">Estado civil</dt>
          <dd class="col-sm-8"><%= I18n.t("clients.marital_statuses.#{@client.marital_status}", default: @client.marital_status) %></dd>

          <dt class="col-sm-4">Nascimento</dt>
          <dd class="col-sm-8"><%= @client.birth_date&.strftime("%d/%m/%Y") || "—" %></dd>

          <dt class="col-sm-4">Nacionalidade</dt>
          <dd class="col-sm-8"><%= @client.nationality.presence || "—" %></dd>

          <dt class="col-sm-4">Profissão</dt>
          <dd class="col-sm-8"><%= @client.profession.presence || "—" %></dd>
        </dl>
      </div>
    </div>
  </div>

  <div class="col-12 col-lg-6">
    <div class="card h-100">
      <div class="card-header">Contato &amp; Endereço</div>
      <div class="card-body">
        <dl class="row mb-0">
          <dt class="col-sm-4">E-mail</dt>
          <dd class="col-sm-8"><%= @client.email.presence || "—" %></dd>

          <dt class="col-sm-4">Telefones</dt>
          <dd class="col-sm-8"><%= @client.phones.join(", ").presence || "—" %></dd>

          <% if @client.cep.present? %>
            <dt class="col-sm-4">CEP</dt>
            <dd class="col-sm-8"><%= @client.cep.cep %></dd>

            <dt class="col-sm-4">Logradouro</dt>
            <dd class="col-sm-8"><%= @client.cep.street %>, <%= @client.address_number %></dd>

            <% if @client.complement.present? %>
              <dt class="col-sm-4">Complemento</dt>
              <dd class="col-sm-8"><%= @client.complement %></dd>
            <% end %>

            <dt class="col-sm-4">Bairro</dt>
            <dd class="col-sm-8"><%= @client.cep.neighborhood.name %></dd>

            <dt class="col-sm-4">Cidade</dt>
            <dd class="col-sm-8"><%= @client.cep.neighborhood.city.name %> / <%= @client.cep.neighborhood.city.state.abbreviation %></dd>
          <% end %>
        </dl>
      </div>
    </div>
  </div>
</div>
