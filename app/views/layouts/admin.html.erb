<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title><%= content_for(:title).presence || "Forge Imobiliária" %></title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,600,700" rel="stylesheet" />
    <!-- Nucleo Icons -->
    <link href="https://unpkg.com/@creative-tim-official/argon-dashboard@2.0.4/assets/css/nucleo-icons.css" rel="stylesheet" />
    <link href="https://unpkg.com/@creative-tim-official/argon-dashboard@2.0.4/assets/css/nucleo-svg.css" rel="stylesheet" />
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet" />
    <!-- Argon Dashboard CSS -->
    <link href="https://unpkg.com/@creative-tim-official/argon-dashboard@2.0.4/assets/css/argon-dashboard.min.css" rel="stylesheet" />
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= yield :head %>
  </head>

  <body class="g-sidenav-show bg-gray-100"
        data-controller="notifications"
        data-notifications-notice-value="<%= notice.to_s %>"
        data-notifications-alert-value="<%= alert.to_s %>">

    <%# Sidenav %>
    <aside class="sidenav bg-white navbar navbar-vertical navbar-expand-xs border-0 border-radius-xl my-3 fixed-start ms-4" id="sidenav-main">
      <div class="sidenav-header">
        <i class="fas fa-times p-3 cursor-pointer text-secondary opacity-5 position-absolute end-0 top-0 d-none d-xl-none" aria-hidden="true" id="iconSidenav"></i>
        <%= link_to root_path, class: "navbar-brand m-0 py-0 px-0 d-flex align-items-center" do %>
          <span class="font-weight-bold ms-2 text-sm">Forge Imobiliária</span>
        <% end %>
      </div>
      <hr class="horizontal dark mt-0">
      <div class="collapse navbar-collapse w-auto" id="sidenav-collapse-main">
        <ul class="navbar-nav">

          <li class="nav-item">
            <%= link_to root_path, class: "nav-link #{current_page?(root_path) ? "active" : ""}" do %>
              <div class="icon icon-shape icon-sm shadow border-radius-md bg-white text-center me-2 d-flex align-items-center justify-content-center">
                <i class="fas fa-chart-line text-primary text-sm opacity-10"></i>
              </div>
              <span class="nav-link-text ms-1">Dashboard</span>
            <% end %>
          </li>

          <li class="nav-item mt-3">
            <h6 class="ps-4 ms-2 text-uppercase text-xs font-weight-bolder opacity-6">Gestão</h6>
          </li>

          <li class="nav-item">
            <%= link_to properties_path, class: "nav-link #{request.path.start_with?("/properties") ? "active" : ""}" do %>
              <div class="icon icon-shape icon-sm shadow border-radius-md bg-white text-center me-2 d-flex align-items-center justify-content-center">
                <i class="fas fa-home text-warning text-sm opacity-10"></i>
              </div>
              <span class="nav-link-text ms-1">Imóveis</span>
            <% end %>
          </li>

          <li class="nav-item">
            <%= link_to clients_path, class: "nav-link #{request.path.start_with?("/clients") ? "active" : ""}" do %>
              <div class="icon icon-shape icon-sm shadow border-radius-md bg-white text-center me-2 d-flex align-items-center justify-content-center">
                <i class="fas fa-users text-success text-sm opacity-10"></i>
              </div>
              <span class="nav-link-text ms-1">Clientes</span>
            <% end %>
          </li>

          <li class="nav-item">
            <%= link_to contracts_path, class: "nav-link #{request.path.start_with?("/contracts") ? "active" : ""}" do %>
              <div class="icon icon-shape icon-sm shadow border-radius-md bg-white text-center me-2 d-flex align-items-center justify-content-center">
                <i class="fas fa-file-contract text-info text-sm opacity-10"></i>
              </div>
              <span class="nav-link-text ms-1">Contratos</span>
            <% end %>
          </li>

          <li class="nav-item mt-3">
            <h6 class="ps-4 ms-2 text-uppercase text-xs font-weight-bolder opacity-6">Configurações</h6>
          </li>

          <li class="nav-item">
            <%= link_to contract_templates_path, class: "nav-link #{request.path.start_with?("/contract_templates") ? "active" : ""}" do %>
              <div class="icon icon-shape icon-sm shadow border-radius-md bg-white text-center me-2 d-flex align-items-center justify-content-center">
                <i class="fas fa-file-alt text-secondary text-sm opacity-10"></i>
              </div>
              <span class="nav-link-text ms-1">Modelos de contrato</span>
            <% end %>
          </li>

          <li class="nav-item">
            <%= link_to users_path, class: "nav-link #{request.path.start_with?("/users") ? "active" : ""}" do %>
              <div class="icon icon-shape icon-sm shadow border-radius-md bg-white text-center me-2 d-flex align-items-center justify-content-center">
                <i class="fas fa-user text-secondary text-sm opacity-10"></i>
              </div>
              <span class="nav-link-text ms-1">Usuários</span>
            <% end %>
          </li>

          <li class="nav-item mt-3">
            <h6 class="ps-4 ms-2 text-uppercase text-xs font-weight-bolder opacity-6">Conta</h6>
          </li>

          <li class="nav-item">
            <%= link_to edit_user_registration_path, class: "nav-link #{current_page?(edit_user_registration_path) ? "active" : ""}" do %>
              <div class="icon icon-shape icon-sm shadow border-radius-md bg-white text-center me-2 d-flex align-items-center justify-content-center">
                <i class="fas fa-cog text-secondary text-sm opacity-10"></i>
              </div>
              <span class="nav-link-text ms-1">Meu Perfil</span>
            <% end %>
          </li>

          <li class="nav-item">
            <%= button_to destroy_user_session_path, method: :delete,
                class: "nav-link border-0 bg-transparent w-100 text-start d-flex align-items-center" do %>
              <div class="icon icon-shape icon-sm shadow border-radius-md bg-white text-center me-2 d-flex align-items-center justify-content-center flex-shrink-0">
                <i class="fas fa-sign-out-alt text-danger text-sm opacity-10"></i>
              </div>
              <span class="nav-link-text ms-1">Sair</span>
            <% end %>
          </li>

        </ul>
      </div>
    </aside>
    <%# /Sidenav %>

    <%# Main Content %>
    <main class="main-content position-relative max-height-vh-100 h-100 border-radius-lg">

      <%# Navbar %>
      <nav class="navbar navbar-main navbar-expand-lg px-0 mx-4 shadow-none border-radius-xl" id="navbarBlur" navbar-scroll="true">
        <div class="container-fluid py-1 px-3">
          <div class="collapse navbar-collapse mt-sm-0 mt-2 me-md-0 me-sm-4" id="navbar">
            <div class="ms-md-auto pe-md-3 d-flex align-items-center"></div>
            <ul class="navbar-nav justify-content-end">
              <li class="nav-item d-xl-none ps-3 d-flex align-items-center">
                <a href="javascript:;" class="nav-link text-body p-0" id="iconNavbarSidenav">
                  <div class="sidenav-toggler-inner">
                    <i class="sidenav-toggler-line"></i>
                    <i class="sidenav-toggler-line"></i>
                    <i class="sidenav-toggler-line"></i>
                  </div>
                </a>
              </li>
              <li class="nav-item dropdown pe-2 d-flex align-items-center">
                <a href="javascript:;" class="nav-link text-body p-0" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                  <i class="fa fa-user me-sm-1"></i>
                  <span class="d-sm-inline d-none"><%= current_user.email %></span>
                </a>
                <ul class="dropdown-menu dropdown-menu-end px-2 py-3 me-sm-n4" aria-labelledby="dropdownMenuButton">
                  <li class="mb-2">
                    <%= link_to "Meu Perfil", edit_user_registration_path, class: "dropdown-item border-radius-md" %>
                  </li>
                  <li>
                    <%= button_to "Sair", destroy_user_session_path, method: :delete,
                        class: "dropdown-item border-radius-md border-0 bg-transparent w-100 text-start" %>
                  </li>
                </ul>
              </li>
            </ul>
          </div>
        </div>
      </nav>
      <%# /Navbar %>

      <div class="container-fluid py-4">
        <%= yield %>
      </div>

      <%# Footer %>
      <footer class="footer py-4">
        <div class="container-fluid">
          <div class="row align-items-center justify-content-lg-between">
            <div class="col-lg-6 mb-lg-0 mb-4">
              <div class="copyright text-center text-sm text-muted text-lg-start">
                Forge Imobiliária &copy; <%= Time.current.year %>
              </div>
            </div>
          </div>
        </div>
      </footer>
      <%# /Footer %>

    </main>
    <%# /Main Content %>

    <%= javascript_importmap_tags %>
    <script src="https://unpkg.com/@creative-tim-official/argon-dashboard@2.0.4/assets/js/core/popper.min.js"></script>
    <script src="https://unpkg.com/@creative-tim-official/argon-dashboard@2.0.4/assets/js/core/bootstrap.min.js"></script>
    <script src="https://unpkg.com/@creative-tim-official/argon-dashboard@2.0.4/assets/js/plugins/perfect-scrollbar.min.js"></script>
    <script src="https://unpkg.com/@creative-tim-official/argon-dashboard@2.0.4/assets/js/plugins/smooth-scrollbar.min.js"></script>
    <script src="https://unpkg.com/@creative-tim-official/argon-dashboard@2.0.4/assets/js/argon-dashboard.min.js"></script>
    <%= yield :scripts %>
  </body>
</html>
