<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">Contratos</h1>
  <%= link_to "Novo contrato", new_contract_path, class: "btn btn-primary" %>
</div>

<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>Número</th>
            <th>Tipo</th>
            <th>Imóvel</th>
            <th>Parte</th>
            <th>Início</th>
            <th>Status</th>
            <th class="text-end">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% if @contracts.any? %>
            <% @contracts.each do |contract| %>
              <tr>
                <td class="align-middle fw-semibold"><%= contract.contract_number %></td>
                <td class="align-middle">
                  <% if contract.sale? %>
                    <span class="badge bg-primary">Venda</span>
                  <% else %>
                    <span class="badge bg-info text-dark">Locação</span>
                  <% end %>
                </td>
                <td class="align-middle"><%= contract.property.title %></td>
                <td class="align-middle">
                  <%= contract.sale? ? contract.buyer&.name : contract.tenant&.name %>
                </td>
                <td class="align-middle"><%= contract.start_date&.strftime("%d/%m/%Y") %></td>
                <td class="align-middle">
                  <% badge = { "active" => "bg-success", "completed" => "bg-secondary", "cancelled" => "bg-danger" } %>
                  <% label = { "active" => "Ativo", "completed" => "Concluído", "cancelled" => "Cancelado" } %>
                  <span class="badge <%= badge[contract.status] %>"><%= label[contract.status] %></span>
                </td>
                <td class="align-middle text-end text-nowrap">
                  <%= link_to "Ver", contract_path(contract), class: "btn btn-sm btn-outline-secondary" %>
                  <%= link_to "Editar", edit_contract_path(contract), class: "btn btn-sm btn-outline-primary ms-1" %>
                  <%= button_to "Excluir", contract_path(contract), method: :delete,
                      class: "btn btn-sm btn-outline-danger ms-1",
                      form: { data: { turbo_confirm: "Tem certeza que deseja excluir o contrato #{contract.contract_number}?" } } %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="7" class="text-center text-muted py-4">Nenhum contrato encontrado.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
