<% content_for :title, "Dashboard — Forge Imobiliária" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h4 class="mb-0">Dashboard</h4>
  <span class="text-muted text-sm"><%= Date.current.strftime("%d de %B de %Y") %></span>
</div>

<%# KPIs principais %>
<div class="row g-3 mb-4">
  <div class="col-sm-6 col-xl-3">
    <div class="card">
      <div class="card-body p-3">
        <div class="row">
          <div class="col-8">
            <div class="numbers">
              <p class="text-sm mb-0 text-uppercase font-weight-bold">Clientes</p>
              <h5 class="font-weight-bolder mb-0"><%= @total_clients %></h5>
            </div>
          </div>
          <div class="col-4 text-end">
            <div class="icon icon-shape bg-gradient-primary shadow text-center border-radius-md">
              <i class="fas fa-users text-lg opacity-10 text-white" aria-hidden="true"></i>
            </div>
          </div>
        </div>
        <p class="mb-0 mt-2">
          <%= link_to "Ver clientes →", clients_path, class: "text-sm font-weight-bolder text-primary text-decoration-none" %>
        </p>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-xl-3">
    <div class="card">
      <div class="card-body p-3">
        <div class="row">
          <div class="col-8">
            <div class="numbers">
              <p class="text-sm mb-0 text-uppercase font-weight-bold">Imóveis</p>
              <h5 class="font-weight-bolder mb-0"><%= @total_properties %></h5>
            </div>
          </div>
          <div class="col-4 text-end">
            <div class="icon icon-shape bg-gradient-info shadow text-center border-radius-md">
              <i class="fas fa-home text-lg opacity-10 text-white" aria-hidden="true"></i>
            </div>
          </div>
        </div>
        <p class="mb-0 mt-2">
          <span class="badge badge-sm bg-gradient-primary me-1"><%= @properties_for_sale %> venda</span>
          <span class="badge badge-sm bg-gradient-info"><%= @properties_for_rent %> aluguel</span>
        </p>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-xl-3">
    <div class="card">
      <div class="card-body p-3">
        <div class="row">
          <div class="col-8">
            <div class="numbers">
              <p class="text-sm mb-0 text-uppercase font-weight-bold">Contratos ativos</p>
              <h5 class="font-weight-bolder mb-0"><%= @active_contracts %></h5>
            </div>
          </div>
          <div class="col-4 text-end">
            <div class="icon icon-shape bg-gradient-success shadow text-center border-radius-md">
              <i class="fas fa-file-contract text-lg opacity-10 text-white" aria-hidden="true"></i>
            </div>
          </div>
        </div>
        <p class="mb-0 mt-2">
          <span class="badge badge-sm bg-gradient-success me-1"><%= @sale_contracts %> venda</span>
          <span class="badge badge-sm bg-gradient-warning"><%= @rental_contracts %> aluguel</span>
        </p>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-xl-3">
    <div class="card">
      <div class="card-body p-3">
        <div class="row">
          <div class="col-8">
            <div class="numbers">
              <p class="text-sm mb-0 text-uppercase font-weight-bold">Receita este mês</p>
              <h5 class="font-weight-bolder mb-0"><%= number_to_currency(@monthly_revenue, unit: "R$", separator: ",", delimiter: ".") %></h5>
            </div>
          </div>
          <div class="col-4 text-end">
            <div class="icon icon-shape bg-gradient-warning shadow text-center border-radius-md">
              <i class="fas fa-dollar-sign text-lg opacity-10 text-white" aria-hidden="true"></i>
            </div>
          </div>
        </div>
        <p class="mb-0 mt-2 text-sm text-muted">
          Total: <%= number_to_currency(@total_revenue, unit: "R$", separator: ",", delimiter: ".") %>
        </p>
      </div>
    </div>
  </div>
</div>

<%# Tabelas de dados recentes %>
<div class="row g-3">
  <%# Contratos recentes %>
  <div class="col-12 col-xl-7">
    <div class="card h-100">
      <div class="card-header pb-0">
        <div class="d-flex justify-content-between align-items-center">
          <h6 class="mb-0">Contratos recentes</h6>
          <%= link_to "Ver todos", contracts_path, class: "btn btn-sm btn-outline-primary mb-0" %>
        </div>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead>
              <tr>
                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 ps-3">Nº Contrato</th>
                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Imóvel</th>
                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Tipo</th>
                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Status</th>
                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Data</th>
              </tr>
            </thead>
            <tbody>
              <% if @recent_contracts.any? %>
                <% @recent_contracts.each do |contract| %>
                  <tr>
                    <td class="ps-3">
                      <%= link_to contract.contract_number, contract_path(contract), class: "text-decoration-none fw-semibold text-sm" %>
                    </td>
                    <td class="text-truncate text-sm" style="max-width: 180px;">
                      <%= contract.property.title %>
                    </td>
                    <td>
                      <% if contract.sale? %>
                        <span class="badge badge-sm bg-gradient-primary">Venda</span>
                      <% else %>
                        <span class="badge badge-sm bg-gradient-info">Aluguel</span>
                      <% end %>
                    </td>
                    <td>
                      <% case contract.status %>
                      <% when "active" %>
                        <span class="badge badge-sm bg-gradient-success">Ativo</span>
                      <% when "completed" %>
                        <span class="badge badge-sm bg-gradient-secondary">Encerrado</span>
                      <% when "cancelled" %>
                        <span class="badge badge-sm bg-gradient-danger">Cancelado</span>
                      <% end %>
                    </td>
                    <td class="text-muted text-sm">
                      <%= contract.signed_at.present? ? contract.signed_at.strftime("%d/%m/%Y") : "—" %>
                    </td>
                  </tr>
                <% end %>
              <% else %>
                <tr>
                  <td colspan="5" class="text-center text-muted py-4 text-sm">Nenhum contrato encontrado.</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <%# Pagamentos recentes %>
  <div class="col-12 col-xl-5">
    <div class="card h-100">
      <div class="card-header pb-0">
        <h6 class="mb-0">Pagamentos recentes</h6>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead>
              <tr>
                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 ps-3">Imóvel</th>
                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Valor</th>
                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Data</th>
              </tr>
            </thead>
            <tbody>
              <% if @recent_payments.any? %>
                <% @recent_payments.each do |payment| %>
                  <tr>
                    <td class="text-truncate text-sm ps-3" style="max-width: 160px;">
                      <%= payment.contract.property.title %>
                    </td>
                    <td class="fw-semibold text-success text-sm">
                      <%= number_to_currency(payment.amount, unit: "R$", separator: ",", delimiter: ".") %>
                    </td>
                    <td class="text-muted text-sm">
                      <%= payment.payment_date.strftime("%d/%m/%Y") %>
                    </td>
                  </tr>
                <% end %>
              <% else %>
                <tr>
                  <td colspan="3" class="text-center text-muted py-4 text-sm">Nenhum pagamento encontrado.</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
