<% content_for :title, "Dashboard — Forge Imobiliária" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">Dashboard</h1>
  <span class="text-muted small"><%= Date.current.strftime("%d de %B de %Y") %></span>
</div>

<%# KPIs principais %>
<div class="row g-3 mb-4">
  <div class="col-sm-6 col-xl-3">
    <div class="card h-100">
      <div class="card-body d-flex align-items-center gap-3">
        <div class="bg-primary bg-opacity-10 rounded p-3">
          <i class="cil-people text-primary fs-4"></i>
        </div>
        <div>
          <div class="fs-4 fw-bold"><%= @total_clients %></div>
          <div class="text-muted small">Clientes</div>
        </div>
      </div>
      <div class="card-footer bg-transparent border-top-0 pt-0">
        <%= link_to "Ver clientes →", clients_path, class: "text-primary small text-decoration-none" %>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-xl-3">
    <div class="card h-100">
      <div class="card-body d-flex align-items-center gap-3">
        <div class="bg-info bg-opacity-10 rounded p-3">
          <i class="cil-home text-info fs-4"></i>
        </div>
        <div>
          <div class="fs-4 fw-bold"><%= @total_properties %></div>
          <div class="text-muted small">Imóveis</div>
        </div>
      </div>
      <div class="card-footer bg-transparent border-top-0 pt-0">
        <span class="text-muted small">
          <span class="badge bg-primary"><%= @properties_for_sale %> venda</span>
          <span class="badge bg-info text-dark ms-1"><%= @properties_for_rent %> aluguel</span>
        </span>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-xl-3">
    <div class="card h-100">
      <div class="card-body d-flex align-items-center gap-3">
        <div class="bg-success bg-opacity-10 rounded p-3">
          <i class="cil-description text-success fs-4"></i>
        </div>
        <div>
          <div class="fs-4 fw-bold"><%= @active_contracts %></div>
          <div class="text-muted small">Contratos ativos</div>
        </div>
      </div>
      <div class="card-footer bg-transparent border-top-0 pt-0">
        <span class="text-muted small">
          <span class="badge bg-success"><%= @sale_contracts %> venda</span>
          <span class="badge bg-warning text-dark ms-1"><%= @rental_contracts %> aluguel</span>
        </span>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-xl-3">
    <div class="card h-100">
      <div class="card-body d-flex align-items-center gap-3">
        <div class="bg-warning bg-opacity-10 rounded p-3">
          <i class="cil-money text-warning fs-4"></i>
        </div>
        <div>
          <div class="fs-4 fw-bold"><%= number_to_currency(@monthly_revenue, unit: "R$", separator: ",", delimiter: ".") %></div>
          <div class="text-muted small">Receita este mês</div>
        </div>
      </div>
      <div class="card-footer bg-transparent border-top-0 pt-0">
        <span class="text-muted small">Total: <%= number_to_currency(@total_revenue, unit: "R$", separator: ",", delimiter: ".") %></span>
      </div>
    </div>
  </div>
</div>

<%# Tabelas de dados recentes %>
<div class="row g-3">
  <%# Contratos recentes %>
  <div class="col-12 col-xl-7">
    <div class="card h-100">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Contratos recentes</h5>
        <%= link_to "Ver todos", contracts_path, class: "btn btn-sm btn-outline-primary" %>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th>Nº Contrato</th>
                <th>Imóvel</th>
                <th>Tipo</th>
                <th>Status</th>
                <th>Data</th>
              </tr>
            </thead>
            <tbody>
              <% if @recent_contracts.any? %>
                <% @recent_contracts.each do |contract| %>
                  <tr>
                    <td class="align-middle">
                      <%= link_to contract.contract_number, contract_path(contract), class: "text-decoration-none fw-semibold" %>
                    </td>
                    <td class="align-middle text-truncate" style="max-width: 180px;">
                      <%= contract.property.title %>
                    </td>
                    <td class="align-middle">
                      <% if contract.sale? %>
                        <span class="badge bg-primary">Venda</span>
                      <% else %>
                        <span class="badge bg-info text-dark">Aluguel</span>
                      <% end %>
                    </td>
                    <td class="align-middle">
                      <% case contract.status %>
                      <% when "active" %>
                        <span class="badge bg-success">Ativo</span>
                      <% when "completed" %>
                        <span class="badge bg-secondary">Encerrado</span>
                      <% when "cancelled" %>
                        <span class="badge bg-danger">Cancelado</span>
                      <% end %>
                    </td>
                    <td class="align-middle text-muted small">
                      <%= contract.signed_at.present? ? contract.signed_at.strftime("%d/%m/%Y") : "—" %>
                    </td>
                  </tr>
                <% end %>
              <% else %>
                <tr>
                  <td colspan="5" class="text-center text-muted py-4">Nenhum contrato encontrado.</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <%# Pagamentos recentes %>
  <div class="col-12 col-xl-5">
    <div class="card h-100">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Pagamentos recentes</h5>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th>Imóvel</th>
                <th>Valor</th>
                <th>Data</th>
              </tr>
            </thead>
            <tbody>
              <% if @recent_payments.any? %>
                <% @recent_payments.each do |payment| %>
                  <tr>
                    <td class="align-middle text-truncate" style="max-width: 160px;">
                      <%= payment.contract.property.title %>
                    </td>
                    <td class="align-middle fw-semibold text-success">
                      <%= number_to_currency(payment.amount, unit: "R$", separator: ",", delimiter: ".") %>
                    </td>
                    <td class="align-middle text-muted small">
                      <%= payment.payment_date.strftime("%d/%m/%Y") %>
                    </td>
                  </tr>
                <% end %>
              <% else %>
                <tr>
                  <td colspan="3" class="text-center text-muted py-4">Nenhum pagamento encontrado.</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
