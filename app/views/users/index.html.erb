<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">Usuários</h1>
  <%= link_to "Novo usuário", new_user_path, class: "btn btn-primary" %>
</div>

<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>Nome</th>
            <th>E-mail</th>
            <th>Status</th>
            <th class="text-end">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% if @users.any? %>
            <% @users.each do |user| %>
              <tr>
                <td class="align-middle"><%= user.name %></td>
                <td class="align-middle"><%= user.email %></td>
                <td class="align-middle">
                  <% if user.is_active? %>
                    <span class="badge bg-success">Ativo</span>
                  <% else %>
                    <span class="badge bg-secondary">Inativo</span>
                  <% end %>
                </td>
                <td class="align-middle text-end text-nowrap">
                  <%= link_to "Ver", user_path(user), class: "btn btn-sm btn-outline-secondary" %>
                  <%= link_to "Editar", edit_user_path(user), class: "btn btn-sm btn-outline-primary ms-1" %>
                  <%= button_to "Excluir", user_path(user), method: :delete,
                      class: "btn btn-sm btn-outline-danger ms-1",
                      form: { data: { turbo_confirm: "Tem certeza que deseja excluir #{user.name}?" } } %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="4" class="text-center text-muted py-4">Nenhum usuário encontrado.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
