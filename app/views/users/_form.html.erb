<%= form_with model: user, class: "needs-validation" do |f| %>
  <% if user.errors.any? %>
    <div data-controller="notifications"
         data-notifications-errors-value="<%= user.errors.full_messages.to_json %>">
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, "Nome", class: "form-label" %>
    <%= f.text_field :name, class: "form-control #{"is-invalid" if user.errors[:name].any?}",
        autofocus: true %>
    <% if user.errors[:name].any? %>
      <div class="invalid-feedback"><%= user.errors[:name].first %></div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= f.label :email, "E-mail", class: "form-label" %>
    <%= f.email_field :email, class: "form-control #{"is-invalid" if user.errors[:email].any?}" %>
    <% if user.errors[:email].any? %>
      <div class="invalid-feedback"><%= user.errors[:email].first %></div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= f.label :password, user.persisted? ? "Nova senha (deixe em branco para manter)" : "Senha",
        class: "form-label" %>
    <%= f.password_field :password,
        class: "form-control #{"is-invalid" if user.errors[:password].any?}",
        autocomplete: "new-password" %>
    <% if user.errors[:password].any? %>
      <div class="invalid-feedback"><%= user.errors[:password].first %></div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= f.label :password_confirmation, "Confirmar senha", class: "form-label" %>
    <%= f.password_field :password_confirmation, class: "form-control", autocomplete: "new-password" %>
  </div>

  <div class="mb-4">
    <div class="form-check form-switch">
      <%= f.check_box :is_active, class: "form-check-input", role: "switch" %>
      <%= f.label :is_active, "Usuário ativo", class: "form-check-label" %>
    </div>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit user.persisted? ? "Salvar alterações" : "Criar usuário",
        class: "btn btn-primary" %>
    <%= link_to "Cancelar", users_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
