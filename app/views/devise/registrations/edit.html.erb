<div class="container-lg px-4">
  <div class="row">
    <div class="col-12">
      <div class="card mb-4">
        <div class="card-header"><strong>Meu Perfil</strong></div>
        <div class="card-body">
          <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
            <%= render "devise/shared/error_messages", resource: resource %>

            <div class="mb-3">
              <%= f.label :email, "E-mail", class: "form-label" %>
              <%= f.email_field :email, autofocus: true, autocomplete: "email",
                  class: "form-control" %>
              <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
                <div class="form-text text-warning">
                  Aguardando confirmação de: <%= resource.unconfirmed_email %>
                </div>
              <% end %>
            </div>

            <hr>
            <p class="text-muted small">Preencha os campos abaixo apenas para alterar a senha.</p>

            <div class="mb-3">
              <%= f.label :password, "Nova senha", class: "form-label" %>
              <% if @minimum_password_length %>
                <small class="text-muted d-block">mínimo <%= @minimum_password_length %> caracteres</small>
              <% end %>
              <%= f.password_field :password, autocomplete: "new-password",
                  class: "form-control", placeholder: "deixe em branco para manter" %>
            </div>

            <div class="mb-3">
              <%= f.label :password_confirmation, "Confirmar nova senha", class: "form-label" %>
              <%= f.password_field :password_confirmation, autocomplete: "new-password",
                  class: "form-control" %>
            </div>

            <hr>

            <div class="mb-3">
              <%= f.label :current_password, "Senha atual", class: "form-label" %>
              <small class="text-muted d-block">necessária para confirmar as alterações</small>
              <%= f.password_field :current_password, autocomplete: "current-password",
                  class: "form-control" %>
            </div>

            <div class="d-flex gap-2">
              <%= f.submit "Salvar alterações", class: "btn btn-primary" %>
              <%= link_to "Voltar", :back, class: "btn btn-outline-secondary" %>
            </div>
          <% end %>
        </div>
      </div>

      <div class="card border-danger">
        <div class="card-header text-danger"><strong>Zona de perigo</strong></div>
        <div class="card-body">
          <p class="text-muted small">Esta ação é irreversível. Sua conta será removida permanentemente.</p>
          <%= button_to "Cancelar minha conta", registration_path(resource_name),
              data: { turbo_confirm: "Tem certeza? Esta ação não pode ser desfeita." },
              method: :delete,
              class: "btn btn-outline-danger btn-sm" %>
        </div>
      </div>
    </div>
  </div>
</div>
